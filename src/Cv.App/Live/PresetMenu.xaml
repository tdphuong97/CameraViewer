<UserControl x:Class="Cv.App.Live.PresetMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Cv.App">
    <UserControl.Resources>
        <!-- The theme's button template puts its content in a horizontal StackPanel, which never stretches. A row with the
             name on the left and the meta on the right needs the content to fill the row, so it gets its own template. -->
        <ControlTemplate x:Key="PresetRowTemplate" TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" RecognizesAccessKey="False" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <!-- The row of the arrangement in use gets accent colours from code; a local value beats this hover trigger. -->
        <Style x:Key="PresetRow" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Template" Value="{StaticResource PresetRowTemplate}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RaisedHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="app:Ui.GlyphSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Button x:Name="Main" Height="32" MinHeight="32" Padding="12,0,10,0" Click="OnMainClick">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="MainText" FontSize="13.5" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11" Margin="10,1,0,0"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Button>

        <!-- Opens above the button; the card's margin leaves room for the shadow (see LayoutPicker). -->
        <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Main}" Placement="Top" VerticalOffset="-8"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Margin="12,12,12,10" Width="300" Padding="12" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.55" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="BỘ SẮP XẾP" Style="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,6" />
                    <StackPanel x:Name="Rows" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10" />

                    <!-- Two rows: the three labels do not fit on one line in 274px. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="NewButton" Grid.ColumnSpan="2" Style="{StaticResource CompactButton}" app:Ui.Glyph="&#xE710;"
                                Content="Lưu thành bộ mới…" Click="OnNewClick" />
                        <Button x:Name="RenameButton" Grid.Row="1" Style="{StaticResource CompactButton}" app:Ui.Glyph="&#xE70F;"
                                Content="Đổi tên" Margin="0,6,3,0" Click="OnRenameClick" />
                        <Button x:Name="DeleteButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource CompactButton}"
                                app:Ui.Glyph="&#xE74D;" Content="Xoá" Margin="3,6,0,0" Click="OnDeleteClick" />
                    </Grid>

                    <!-- Inline form for "Lưu thành bộ mới…" and "Đổi tên" (no dialog). -->
                    <StackPanel x:Name="Form" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBox x:Name="NameBox" PreviewKeyDown="OnNameKeyDown" TextChanged="OnNameChanged" />
                        <TextBlock x:Name="ErrorText" Foreground="{StaticResource WarnBrush}" FontSize="12.5" TextWrapping="Wrap"
                                   Margin="2,6,0,0" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Style="{StaticResource PrimaryButton}" MinHeight="30" Padding="18,0" FontSize="13" Content="Lưu"
                                    Click="OnSaveClick" />
                            <Button Style="{StaticResource CompactButton}" Margin="6,0,0,0" Content="Huỷ" Click="OnCancelClick" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Mọi chỉnh sửa tự lưu vào bộ đang chọn." Style="{StaticResource Muted}" FontSize="12"
                               Margin="2,12,0,0" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
