<UserControl x:Class="Cv.App.Live.CameraDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Cv.App"
             Width="276">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title + close -->
            <Grid Margin="16,8,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Camera" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center" />
                <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource IconButton}" app:Ui.Glyph="&#xE711;"
                        app:Ui.GlyphSize="14" ToolTip="Đóng" />
            </Grid>
            <TextBlock Grid.Row="1" Text="Kéo một camera thả vào khung." Style="{StaticResource Muted}" FontSize="12.5"
                       Margin="16,0,16,10" />

            <!-- Sections and rows are built in code (Bind) -->
            <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Items" Margin="8,0,8,12" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
