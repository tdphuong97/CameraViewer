<UserControl x:Class="Cv.App.Live.CameraTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Cv.App"
             xmlns:video="clr-namespace:Cv.App.Video">
    <Grid x:Name="Root" Background="Black" ClipToBounds="True" AllowDrop="True">
        <video:VideoView x:Name="Video" />
        <Border x:Name="EmptyFill" Background="{StaticResource PanelBrush}" Visibility="Collapsed" />

        <StackPanel x:Name="Overlay" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" Visibility="Collapsed">
            <TextBlock x:Name="OverlayIcon" Style="{StaticResource Icon}" FontSize="22" HorizontalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" />
            <TextBlock x:Name="OverlayText" FontSize="13" Foreground="{StaticResource SubtleBrush}" Margin="0,8,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="NameStrip" VerticalAlignment="Bottom" Padding="10,5,10,6">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#000B0D10" Offset="0" />
                    <GradientStop Color="#C40B0D10" Offset="0.55" />
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock x:Name="NameText" FontSize="13" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                       Margin="0,6,0,0" />
        </Border>

        <StackPanel x:Name="HoverBar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                    Visibility="Collapsed">
            <Button x:Name="PlaybackButton" Style="{StaticResource OverlayButton}" app:Ui.Glyph="&#xE81C;" ToolTip="Xem lại"
                    Click="OnPlayback" />
            <Button x:Name="SnapshotButton" Style="{StaticResource OverlayButton}" app:Ui.Glyph="&#xE722;" ToolTip="Chụp ảnh"
                    Click="OnSnapshot" />
            <Button x:Name="ZoomButton" Style="{StaticResource OverlayButton}" app:Ui.Glyph="&#xE740;" ToolTip="Phóng to"
                    Click="OnZoom" />
        </StackPanel>

        <Border x:Name="DropHighlight" BorderBrush="{StaticResource AccentBrush}" BorderThickness="3" Visibility="Collapsed" />
    </Grid>
</UserControl>
