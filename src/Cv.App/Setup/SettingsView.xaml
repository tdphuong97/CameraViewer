<UserControl x:Class="Cv.App.Setup.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Cv.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="820" Margin="32,26,32,32">

            <!-- First run -->
            <Border x:Name="FirstRunBanner" Background="{StaticResource AccentSoftBrush}" BorderBrush="#29436B" BorderThickness="1"
                    CornerRadius="10" Padding="22,18" Margin="0,0,0,20" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentBrush}" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE839;" FontSize="20" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="Kết nối đầu ghi lần đầu" Style="{StaticResource H2}" FontSize="18" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="14" Foreground="{StaticResource SubtleBrush}" Margin="0,6,0,0"
                                   Text="Nhập địa chỉ và tài khoản của đầu ghi, bấm Kiểm tra kết nối, rồi bấm Lưu. Chỉ cần làm một lần." />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Cài đặt" Style="{StaticResource H1}" />
            <TextBlock Text="Phần này dành cho bộ phận IT. Người xem camera không cần thay đổi gì ở đây." Style="{StaticResource Muted}"
                       FontSize="13.5" Margin="0,5,0,20" />

            <!-- Recorder -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE839;" FontSize="17" Foreground="{StaticResource AccentHoverBrush}" />
                        <TextBlock Text="Đầu ghi" Style="{StaticResource H2}" Margin="10,0,0,0" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Tên" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NameBox" app:Ui.Placeholder="Đầu ghi" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,0,14">
                            <TextBlock Text="Địa chỉ IP" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="HostBox" app:Ui.Placeholder="ví dụ 192.168.1.64" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Cổng HTTP" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="HttpPortBox" app:Ui.Placeholder="80" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cổng RTSP" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RtspPortBox" app:Ui.Placeholder="554" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="2" Margin="0,0,0,4">
                            <TextBlock Text="Tài khoản" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="UserBox" app:Ui.Placeholder="admin" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,4">
                            <TextBlock Text="Mật khẩu" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" />
                                <TextBlock x:Name="PasswordHint" Text="Đã lưu (để trống nếu không đổi)" Foreground="#5E6678"
                                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TestButton" app:Ui.Glyph="&#xE9D9;" Content="Kiểm tra kết nối" Click="OnTest" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                            <TextBlock x:Name="TestIcon" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,8,0" />
                            <TextBlock x:Name="TestText" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="SaveButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" app:Ui.Glyph="&#xE74E;" Content="Lưu"
                                MinWidth="110" Click="OnSave" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Folders -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="17" Foreground="{StaticResource AccentHoverBrush}" />
                        <TextBlock Text="Thư mục lưu" Style="{StaticResource H2}" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Lưu video vào" Style="{StaticResource FieldLabel}" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ExportFolderBox" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="Đổi…" Margin="8,0,0,0" Click="OnChangeExportFolder" />
                    </Grid>
                    <TextBlock Text="Lưu ảnh vào" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SnapshotFolderBox" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="Đổi…" Margin="8,0,0,0" Click="OnChangeSnapshotFolder" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Viewing -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="17" Foreground="{StaticResource AccentHoverBrush}" />
                        <TextBlock Text="Xem video" Style="{StaticResource H2}" Margin="10,0,0,0" />
                    </StackPanel>
                    <Grid MinHeight="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Giải mã bằng card đồ họa" />
                            <TextBlock Text="Tự động: dùng card đồ họa cho hình lớn để máy chạy nhẹ hơn." Style="{StaticResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource SegmentGroup}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="HwAuto" Style="{StaticResource SegmentButton}" Content="Tự động" GroupName="hw" Click="OnHwChanged" />
                                <RadioButton x:Name="HwOff" Style="{StaticResource SegmentButton}" Content="Tắt" GroupName="hw" Click="OnHwChanged" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14" />
                    <CheckBox x:Name="PauseMinimizedBox" Style="{StaticResource ToggleSwitch}" Click="OnPauseMinimized">
                        <StackPanel>
                            <TextBlock Text="Dừng xem khi thu nhỏ cửa sổ" />
                            <TextBlock Text="Giải phóng bộ nhớ và mạng khi không nhìn màn hình camera." Style="{StaticResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Updates and support -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="17" Foreground="{StaticResource AccentHoverBrush}" />
                        <TextBlock Text="Cập nhật và hỗ trợ" Style="{StaticResource H2}" Margin="10,0,0,0" />
                    </StackPanel>
                    <CheckBox x:Name="CheckUpdatesBox" Style="{StaticResource ToggleSwitch}" Click="OnCheckUpdatesChanged">
                        <StackPanel>
                            <TextBlock Text="Tự kiểm tra bản mới" />
                            <TextBlock Text="Khi có bản mới, phần mềm hiện thông báo để cập nhật bằng một lần bấm." Style="{StaticResource Muted}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" />
                            <TextBlock Text="Camera Viewer" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button x:Name="CheckNowButton" Grid.Column="1" app:Ui.Glyph="&#xE72C;" Content="Kiểm tra bản mới" Click="OnCheckNow" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Chẩn đoán" />
                            <TextBlock x:Name="ProbeText" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                       Text="Kiểm tra kỹ đầu ghi và lưu báo cáo ra Màn hình (Desktop) để gửi bộ phận IT." />
                        </StackPanel>
                        <Button x:Name="ProbeButton" Grid.Column="1" app:Ui.Glyph="&#xE9D9;" Content="Chạy chẩn đoán" Click="OnProbe" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
