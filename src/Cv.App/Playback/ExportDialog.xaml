<UserControl x:Class="Cv.App.Playback.ExportDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Cv.App"
             Focusable="True">
    <Border Style="{StaticResource Card}" Width="520" Padding="30,26,30,24" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}">
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource AccentSoftBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="17" Foreground="{StaticResource AccentHoverBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Lưu đoạn video" Style="{StaticResource H1}" Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource BgBrush}" CornerRadius="8" Padding="14,11" Margin="0,20,0,0"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Camera" Foreground="{StaticResource MutedBrush}" Margin="0,0,18,6" />
                    <TextBlock x:Name="CameraText" Grid.Column="1" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Grid.Row="1" Text="Ngày" Foreground="{StaticResource MutedBrush}" Margin="0,0,18,0" />
                    <TextBlock x:Name="DayText" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" />
                </Grid>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Từ" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FromBox" app:Ui.Placeholder="HH:mm:ss" FontSize="16" TextChanged="OnTimesChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Đến" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ToBox" app:Ui.Placeholder="HH:mm:ss" FontSize="16" TextChanged="OnTimesChanged" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Chọn nhanh độ dài" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
            <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
                <StackPanel x:Name="QuickButtons" Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentButton}" Content="1 phút" Tag="1" GroupName="len" Click="OnQuick" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="5 phút" Tag="5" GroupName="len" Click="OnQuick" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="15 phút" Tag="15" GroupName="len" Click="OnQuick" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="30 phút" Tag="30" GroupName="len" Click="OnQuick" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="LengthText" Margin="0,12,0,0" Foreground="{StaticResource SubtleBrush}" />

            <TextBlock Text="Lưu vào thư mục" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="11,0" MinHeight="38">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="FolderText" Margin="9,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button Grid.Column="1" Content="Đổi…" Margin="8,0,0,0" Click="OnChangeFolder" />
            </Grid>

            <Border x:Name="ErrorBox" Background="#2A1517" BorderBrush="#5A2328" BorderThickness="1" CornerRadius="6"
                    Padding="12,9" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="14" Foreground="{StaticResource DangerBrush}"
                               VerticalAlignment="Top" Margin="0,2,10,0" />
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" MaxWidth="410" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Style="{StaticResource GhostButton}" Content="Hủy" MinWidth="88" Click="OnCancel" />
                <Button Style="{StaticResource PrimaryButton}" app:Ui.Glyph="&#xE74E;" Content="Lưu" MinWidth="128" Margin="8,0,0,0"
                        MinHeight="40" Click="OnSave" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
