<UserControl x:Class="Cv.App.Playback.PlaybackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Cv.App"
             xmlns:video="clr-namespace:Cv.App.Video"
             xmlns:controls="clr-namespace:Cv.App.Controls">
    <UserControl.Resources>
        <!-- Orange bracket icons matching the range handles on the timeline -->
        <Geometry x:Key="MarkStartIcon">M 6,1 L 2,1 L 2,15 L 6,15 M 9,8 L 14,8</Geometry>
        <Geometry x:Key="MarkEndIcon">M 10,1 L 14,1 L 14,15 L 10,15 M 2,8 L 7,8</Geometry>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Camera, day, time -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="18,10">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                    <TextBlock Text="Camera" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="CameraBox" Width="250" DisplayMemberPath="Name" SelectionChanged="OnCameraChanged" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                    <TextBlock Text="Ngày" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Border Style="{StaticResource SegmentGroup}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TodayButton" Style="{StaticResource SegmentButton}" Content="Hôm nay" GroupName="day"
                                         Click="OnToday" />
                            <RadioButton x:Name="YesterdayButton" Style="{StaticResource SegmentButton}" Content="Hôm qua" GroupName="day"
                                         Click="OnYesterday" />
                            <RadioButton x:Name="PickDayButton" Style="{StaticResource SegmentButton}" app:Ui.Glyph="&#xE787;"
                                         Content="Chọn ngày" GroupName="day" Click="OnPickDay" />
                        </StackPanel>
                    </Border>
                    <Popup x:Name="DayPopup" PlacementTarget="{Binding ElementName=PickDayButton}" Placement="Bottom" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Fade">
                        <controls:DayPicker x:Name="DayPicker" />
                    </Popup>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Giờ" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox x:Name="TimeBox" Width="92" app:Ui.Placeholder="HH:mm" TextAlignment="Center" KeyDown="OnTimeKey"
                             ToolTip="Gõ giờ cần xem, ví dụ 14:30" />
                    <Button x:Name="GoButton" Style="{StaticResource PrimaryButton}" app:Ui.Glyph="&#xE768;" Content="Xem"
                            Margin="10,0,0,0" Padding="18,0" Click="OnGo" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Video -->
        <Grid Grid.Row="1" Margin="18,14,18,0" Background="Black">
            <video:VideoView x:Name="Video" />
            <Border x:Name="NameChip" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10,5"
                    Background="{StaticResource OverlayBrush}" CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="13" Foreground="{StaticResource SubtleBrush}" />
                    <TextBlock x:Name="NameChipText" FontSize="13" Margin="8,0,0,0" />
                </StackPanel>
            </Border>
            <Border x:Name="Overlay" Background="{StaticResource OverlayBrush}" CornerRadius="8" Padding="20,13"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="OverlayIcon" Style="{StaticResource Icon}" FontSize="18" />
                    <TextBlock x:Name="OverlayText" FontSize="15" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Clock and transport -->
        <Grid Grid.Row="2" Margin="18,12,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ClockText" FontSize="30" FontWeight="SemiBold" Text="--:--:--" VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular" />
                <TextBlock x:Name="DateText" FontSize="15" Foreground="{StaticResource MutedBrush}" Margin="14,4,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0">
                <Button app:Ui.Glyph="&#xE7A7;" Content="30 giây" ToolTip="Lùi 30 giây" Click="OnBack30" MinHeight="44" />
                <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" app:Ui.Glyph="&#xE769;" app:Ui.GlyphSize="20"
                        Width="64" Height="44" Padding="0" Margin="10,0" ToolTip="Tạm dừng" Click="OnPlayPause" />
                <Button app:Ui.Glyph="&#xE7A6;" Content="30 giây" ToolTip="Tới 30 giây" Click="OnForward30" MinHeight="44" />
            </StackPanel>
            <Button x:Name="SnapshotButton" Grid.Column="2" HorizontalAlignment="Right" app:Ui.Glyph="&#xE722;" Content="Chụp ảnh"
                    Click="OnSnapshot" MinHeight="44" />
        </Grid>

        <!-- Timeline + zoom -->
        <Border Grid.Row="3" Margin="18,0,18,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,8,12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:TimelineControl x:Name="Timeline" />
                <Border Grid.Column="1" Style="{StaticResource SegmentGroup}" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel x:Name="ZoomButtons" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" Content="24 giờ" Tag="24" GroupName="zoom" Click="OnZoom" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="6 giờ" Tag="6" GroupName="zoom" Click="OnZoom" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="1 giờ" Tag="1" GroupName="zoom" Click="OnZoom" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Marks and export -->
        <Grid Grid.Row="4" Margin="18,12,18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Click="OnMarkStart" ToolTip="Đặt điểm bắt đầu tại thời điểm đang xem" MinHeight="40">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource MarkStartIcon}" Stroke="{StaticResource RangeBrush}" StrokeThickness="2" Width="16"
                              Height="16" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock Text="Đánh dấu bắt đầu" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="OnMarkEnd" ToolTip="Đặt điểm kết thúc tại thời điểm đang xem" MinHeight="40" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource MarkEndIcon}" Stroke="{StaticResource RangeBrush}" StrokeThickness="2" Width="16"
                              Height="16" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock Text="Đánh dấu kết thúc" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                <TextBlock x:Name="RangeText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button x:Name="ClearRangeButton" Style="{StaticResource GhostButton}" app:Ui.Glyph="&#xE711;" app:Ui.GlyphSize="11"
                        Content="Bỏ chọn" MinHeight="32" Margin="10,0,0,0" Click="OnClearRange" Visibility="Collapsed" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" app:Ui.Glyph="&#xE74E;" Content="Lưu đoạn video"
                    MinHeight="40" Padding="20,0" Click="OnSaveClip" />
        </Grid>
    </Grid>
</UserControl>
