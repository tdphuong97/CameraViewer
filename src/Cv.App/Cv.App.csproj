<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>CameraViewer</AssemblyName>
    <RootNamespace>Cv.App</RootNamespace>
    <Version>0.9.2</Version>
    <Product>Camera Viewer</Product>
    <ApplicationIcon>Assets\cv.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Demo frame drawing and LibraryImport interop. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Measured with 20 demo tiles (2026-11-07): non-concurrent GC and GC ConserveMemory made no difference beyond noise;
         TieredPGO off gave the lowest steady RAM and ~10 % less CPU, so only that stays. Workstation GC as before. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cv.Core\Cv.Core.csproj" />
    <ProjectReference Include="..\Cv.Media\Cv.Media.csproj" />
    <ProjectReference Include="..\Cv.Diagnostics\Cv.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\cv.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shows the user guide in its own window (Help\HelpWindow.cs); the WebView2 runtime is part of Windows. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!-- The user guide (docs\ built by build\update-help.ps1) ships in help\ next to the exe; the Hướng dẫn button opens it. -->
  <ItemGroup>
    <Content Include="Help\huong-dan.html" Link="help\huong-dan.html" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="Exists('Help\huong-dan.html')" />
  </ItemGroup>

</Project>
