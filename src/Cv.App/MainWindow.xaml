<Window x:Class="Cv.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Cv.App"
        Title="Camera" Width="1440" Height="880" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <Grid x:Name="Root" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,26,0">
                    <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Camera" FontSize="17" FontWeight="SemiBold" Margin="11,0,0,1" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton x:Name="TabLive" Style="{StaticResource TabButton}" app:Ui.Glyph="&#xE714;" Content="Trực tiếp"
                                 GroupName="tabs" Click="OnTabLive" />
                    <RadioButton x:Name="TabPlayback" Style="{StaticResource TabButton}" app:Ui.Glyph="&#xE81C;" Content="Xem lại"
                                 GroupName="tabs" Click="OnTabPlayback" />
                    <RadioButton x:Name="TabSaved" Style="{StaticResource TabButton}" app:Ui.Glyph="&#xE896;" Content="Video đã lưu"
                                 GroupName="tabs" Click="OnTabSaved" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="6" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Padding="10,5" Margin="0,0,10,0" VerticalAlignment="Center"
                            ToolTip="Bộ nhớ máy tính phần mềm đang dùng">
                        <TextBlock x:Name="RamText" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="RAM" />
                    </Border>
                    <RadioButton x:Name="TabSettings" GroupName="tabs" Click="OnTabSettings" ToolTip="Cài đặt"
                                 Cursor="Hand" FocusVisualStyle="{x:Null}" Foreground="{StaticResource SubtleBrush}">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd" Width="40" Height="40" CornerRadius="6" Background="Transparent">
                                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource RaisedBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedSegmentBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Update banner -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource AccentSoftBrush}"
                BorderBrush="#29436B" BorderThickness="0,0,0,1" Padding="18,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UpdateIcon" Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{StaticResource AccentHoverBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="UpdateText" VerticalAlignment="Center" />
                    <ProgressBar x:Name="UpdateProgress" Width="200" Margin="16,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Content="Cập nhật" MinHeight="32" Click="OnUpdateClick" />
                    <Button x:Name="UpdateLater" Style="{StaticResource GhostButton}" Content="Để sau" MinHeight="32" Margin="6,0,0,0"
                            Click="OnUpdateLater" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Screens -->
        <ContentControl x:Name="Host" Grid.Row="2" Focusable="False" />

        <!-- Toasts (top right, under the bar) -->
        <StackPanel x:Name="Toasts" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,14,18,0" Width="380" />

        <!-- Modal dialogs -->
        <Grid x:Name="ModalHost" Grid.RowSpan="3" Visibility="Collapsed" Background="{StaticResource BackdropBrush}">
            <ContentControl x:Name="ModalContent" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
        </Grid>
    </Grid>
</Window>
